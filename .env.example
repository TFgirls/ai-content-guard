# 复制为 .env 并填入 DeepSeek Key（https://platform.deepseek.com/）
DEEPSEEK_API_KEY=sk-your-key-here

# 以下可选：换网关或换模型（任何 OpenAI 兼容端点，如 Ollama / vLLM）
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat

# 人工复核与 OCR 质量阈值（默认值即可）
# REVIEW_CONFIDENCE=0.75
# OCR_LOW_SCORE=0.60

# Agent 循环最多改写几轮（超过则转人工）
# MAX_REWRITE_ROUNDS=3
